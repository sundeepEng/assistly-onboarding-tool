{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es2020", "dom"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./",
    "typeRoots": ["./node_modules/@types", "./layers/nodejs/node_modules/@types"],
    "paths": {
      "*": ["./node_modules/*", "./layers/nodejs/node_modules/*"]
    }
  },
  "include": [
    "functions/**/*.ts",
    "services/**/*.ts",
    "dal/**/*.ts",
    "utils//**/*.ts",
    "models/**/*.ts",
    "migrations/**/*.ts",
    "lib/**/*.ts"
  ],
  "exclude": ["cdk.out", "node_modules"]
}
