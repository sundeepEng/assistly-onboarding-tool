{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "model/clinical/face-sheet.model.ts"
  ],
  "exclude": [
    "node_modules",
    // Cypress and Jest each bring their own global `expect`/`describe` types.
    // Keeping both out of the app program means neither can shadow the other —
    // each has its own tsconfig (cypress/tsconfig.json, __tests__/tsconfig.json).
    "cypress",
    "cypress.config.ts",
    "__tests__",
    "jest.setup.ts"
  ]
}
